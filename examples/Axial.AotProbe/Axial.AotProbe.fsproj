<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.fs" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Axial\Axial.fsproj" AdditionalProperties="TargetFramework=net8.0" />
    <ProjectReference Include="..\..\src\Axial.PlatformService\Axial.PlatformService.fsproj" AdditionalProperties="TargetFramework=net8.0" />
    <ProjectReference Include="..\..\src\Axial.Process\Axial.Process.fsproj" AdditionalProperties="TargetFramework=net8.0" />
    <ProjectReference Include="..\..\src\Axial.FileSystem\Axial.FileSystem.fsproj" AdditionalProperties="TargetFramework=net8.0" />
    <ProjectReference Include="..\..\src\Axial.HttpClient\Axial.HttpClient.fsproj" AdditionalProperties="TargetFramework=net8.0" />
  </ItemGroup>
</Project>
