<Project>
  <PropertyGroup>
    <DocsBuildScope Condition="'$(DocsBuildScope)' == ''">All</DocsBuildScope>
  </PropertyGroup>

  <ItemGroup Condition="'$(DocsBuildScope)' == 'All' Or '$(DocsBuildScope)' == 'Api'">
    <DocsProject Include="../src/Axial/Axial.fsproj" />
    <DocsProject Include="../src/Axial.Process/Axial.Process.fsproj" />
    <DocsProject Include="../src/Axial.Hosting/Axial.Hosting.fsproj" />
    <DocsProject Include="../src/Axial.Hosting.Node/Axial.Hosting.Node.fsproj" />
    <DocsProject Include="../src/Axial.Hosting.Browser/Axial.Hosting.Browser.fsproj" />
    <DocsProject Include="docgen/docgen.fsproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DocsBuildScope)' == 'All' Or '$(DocsBuildScope)' == 'Examples'">
    <DocsProject Include="../examples/Axial.Examples/Axial.Examples.fsproj" />
    <DocsProject Include="../examples/Axial.Playground/Axial.Playground.fsproj" />
    <DocsProject Include="../examples/Axial.MaintenanceExamples/Axial.MaintenanceExamples.fsproj" />
  </ItemGroup>

  <Target Name="Build">
    <MSBuild
      Projects="@(DocsProject)"
      Targets="Build"
      BuildInParallel="true"
      Properties="UseSharedCompilation=true" />
  </Target>
</Project>
