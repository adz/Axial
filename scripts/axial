#!/usr/bin/env bash

# Run this repository's live Axial tool (policy check, review, init) after an incremental build of the analyzer and
# tool, e.g. `scripts/axial check`, `scripts/axial check --full`, `scripts/axial policy review --since v0.11.3`.
# Build output is shown (on stderr, so `--json` stdout stays parseable) only when the build fails: the tool reports
# policy drift itself, and the build's own drift warning would print it twice.

set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if ! build_output="$("$root_dir/scripts/ensure-guardrails-built.sh" Release 2>&1)"; then
  printf '%s\n' "$build_output" >&2
  exit 1
fi
cd "$root_dir"
exec dotnet --roll-forward Major "$root_dir/artifacts/bin/Axial.Tool/release/Axial.Tool.dll" "$@"
