<?xml version="1.0" encoding="utf-8"?>
<!-- Axial packages come only from the feed scripts/run-fable-package-tests.sh packs, into a packages folder of their
     own, so a package already in the user's NuGet cache can never stand in for the one just packed. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/fable-package-tests/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="axial-local" value="../../artifacts/fable-package-tests/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="axial-local">
      <package pattern="Axial" />
      <package pattern="Axial.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
