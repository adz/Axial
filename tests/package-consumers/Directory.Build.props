<Project>

  <!-- Deliberately does not import the repository's Directory.Build.props. These fixtures must see the
       packages exactly as an outside consumer does: restored from a feed, with no repository-wide
       properties, no artifacts layout, and no project references into src/. Inheritance stops here. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>

    <!-- Overridden by scripts/run-package-consumers.sh with the version it just packed. -->
    <AxialPackageVersion Condition="'$(AxialPackageVersion)' == ''">0.7.0</AxialPackageVersion>
  </PropertyGroup>

</Project>
