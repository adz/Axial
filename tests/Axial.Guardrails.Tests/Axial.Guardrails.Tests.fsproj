<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Library</OutputType>
    <AxialGuardrailsEnabled>false</AxialGuardrailsEnabled>
    <!-- F# emits FS0988 for this xUnit library despite OutputType=Library; there is intentionally no entry point.
         NU1605 is expected because analyzer tests must load the exact FSharp.Core used by FCS, while their Axial
         fixture reference was built by the current SDK and advertises its newer FSharp.Core. -->
    <NoWarn>$(NoWarn);FS0988;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AnalyzerTestContext.fs" />
    <Compile Include="ReflectionFormattingAnalyzerTests.fs" />
    <Compile Include="ResourceFromFiberAnalyzerTests.fs" />
    <Compile Include="ScopeFromRunAnalyzerTests.fs" />
    <Compile Include="GuardrailConfigTests.fs" />
    <Compile Include="PackagePropsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Unquote" Version="7.0.0" />
    <PackageReference Update="FSharp.Core" Version="10.1.201" PrivateAssets="all" />
    <PackageReference Include="FSharp.Analyzers.SDK.Testing" Version="0.37.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axial.Guardrails\Axial.Guardrails.fsproj" />
    <ProjectReference Include="..\..\src\Axial\Axial.fsproj" />
  </ItemGroup>

</Project>
