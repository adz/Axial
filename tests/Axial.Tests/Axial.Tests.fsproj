<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);FS0988</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestSupport.fs" />
    <Compile Include="PlatformPackagingTests.fs" />
    <Compile Include="PlatformScopeTests.fs" />
    <Compile Include="CultureTests.fs" />
    <Compile Include="RuntimeFoundationTests.fs" />
    <Compile Include="ServiceRuntimePatternTests.fs" />
    <Compile Include="TestRuntimeTests.fs" />
    <Compile Include="TimeProviderTests.fs" />
    <Compile Include="FlowRuntimeMetadataTests.fs" />
    <Compile Include="RuntimeSemanticsTests.fs" />
    <Compile Include="CoreCancellationClassificationTests.fs" />
    <Compile Include="ExecutionTests.fs" />
    <Compile Include="AppTests.fs" />
    <Compile Include="WorkflowBasicTests.fs" />
    <Compile Include="StackSafetyTests.fs" />
    <Compile Include="TrampolineTests.fs" />
    <Compile Include="WorkflowConcurrencyTests.fs" />
    <Compile Include="WorkflowParallelTests.fs" />
    <Compile Include="RunOnTests.fs" />
    <Compile Include="CacheTests.fs" />
    <Compile Include="WorkflowErrorTests.fs" />
    <Compile Include="WorkflowSchedulingTests.fs" />
    <Compile Include="WorkflowSupervisionTests.fs" />
    <Compile Include="FiberObserverTests.fs" />
    <Compile Include="FiberDiagnosticsTests.fs" />
    <Compile Include="FiberLocalTests.fs" />
    <Compile Include="WorkflowResourceTests.fs" />
    <Compile Include="UninterruptibleCleanupTests.fs" />
    <Compile Include="ScopedResourceOwnershipTests.fs" />
    <Compile Include="ScopeConcurrencyTests.fs" />
    <Compile Include="ParallelSettlementTests.fs" />
    <Compile Include="WorkflowStateTests.fs" />
    <Compile Include="StmPrimitivesTests.fs" />
    <Compile Include="BclInteropTests.fs" />
    <Compile Include="WorkflowQueueTests.fs" />
    <Compile Include="WorkflowHubTests.fs" />
    <Compile Include="WorkflowSubscriptionRefTests.fs" />
    <Compile Include="TortureTests.fs" />
    <Compile Include="TortureCoverageTests.fs" />
    <Compile Include="MemoryRetentionTests.fs" />
    <Compile Include="WorkflowStreamTests.fs" />
    <Compile Include="ReissueTests.fs" />
    <Compile Include="WorkflowCallbackStreamTests.fs" />
    <Compile Include="StreamInteropTests.fs" />
    <Compile Include="PolicyTests.fs" />
    <Compile Include="ThrowSafetyMatrixTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Unquote" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axial\Axial.fsproj" />
    <!-- The phased core migration can validate without the Process-dependent torture graph. -->
    <ProjectReference Include="..\..\examples\Axial.TortureTest\Axial.TortureTest.fsproj" />
  </ItemGroup>

</Project>
