<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);FS0988</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ApiShapeTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Unquote" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axial.Result\Axial.Result.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Constraint\Axial.Constraint.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Refined\Axial.Refined.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Parse\Axial.Parse.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Schema\Axial.Schema.fsproj" />
    <!-- Loaded by name through Assembly.Load. The umbrella package no longer references the optional
         Schema interpreters, so these must be explicit or the reflection-based assertions cannot find them. -->
    <ProjectReference Include="..\..\src\Axial.Schema.Json\Axial.Schema.Json.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Schema.JsonSchema\Axial.Schema.JsonSchema.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Flow.Hosting\Axial.Flow.Hosting.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Flow.Telemetry\Axial.Flow.Telemetry.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Flow.Console\Axial.Flow.Console.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Flow.FileSystem\Axial.Flow.FileSystem.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Flow.HttpClient\Axial.Flow.HttpClient.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Flow.Process\Axial.Flow.Process.fsproj" />
    <ProjectReference Include="..\..\src\Axial.Data\Axial.Data.fsproj" />
  </ItemGroup>

</Project>
