<Project>
  <Target Name="ValidatePackageMaturity" BeforeTargets="Build;Pack" Condition="'$(IsPackable)' != 'false' and $(MSBuildProjectDirectory.Contains('/src/'))">
    <Error Condition="'$(PackageMaturity)' != 'Experimental' and '$(PackageMaturity)' != 'Incubating' and '$(PackageMaturity)' != 'Stable'" Text="$(MSBuildProjectName) must set PackageMaturity to Experimental, Incubating, or Stable." />
  </Target>
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and $(MSBuildProjectDirectory.Contains('/src/')) and '$(PackageMaturity)' != ''">
    <PackageTags>$(PackageTags);maturity-$(PackageMaturity.ToLowerInvariant())</PackageTags>
    <Description>[$(PackageMaturity)] $(Description)</Description>
  </PropertyGroup>

  <!--
    Runs Axial.Guardrails against every project in this repo except itself, the same way a
    package consumer gets it via PackageReference to Axial.Guardrails - see
    src/Axial.Guardrails/build/Axial.Guardrails.targets for the actual check, and
    docs/15-notes/03-guardrails.md for what it covers. No separate script: `dotnet build` (or
    `dotnet test`, for AXG004 in a test project) runs the check as part of the normal build.

    A real consumer never pays a build-order cost for this at all: `dotnet add package
    Axial.Guardrails` restores a nupkg with the analyzer already compiled, sitting in the
    package's own analyzers/ folder - there's nothing to build, so nothing to order against.
    That's only a problem for us, because we deliberately point at this repo's own live source
    (artifacts/bin/Axial.Guardrails/$(Configuration)) instead of a published package, so we're
    always checking against the analyzer's current code. A ProjectReference to Axial.Guardrails
    would force MSBuild to resolve and build-order-check its entire dependency graph - which
    includes FSharp.Compiler.Service, expensive to evaluate - on every single build of every
    single project in the repo, whether or not the check itself ends up running. Instead,
    AxialGuardrailsEnsureBuilt (in the imported targets below) builds Axial.Guardrails directly
    with a plain `dotnet build`, the first time any project finds its output missing - self-healing
    without a graph edge, and near-free on every build after the first.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Axial.Guardrails' and '$(_AxialRepoSkipGuardrails)' != 'true' and '$(MSBuildProjectExtension)' == '.fsproj'">
    <!-- The analyzer's own build output, not the packaged analyzers/ folder these paths default to. -->
    <_AxialGuardrailsAnalyzersPath>$(MSBuildThisFileDirectory)artifacts\bin\Axial.Guardrails\$(Configuration.ToLower())</_AxialGuardrailsAnalyzersPath>
    <!-- The fsharp-analyzers local tool from .config/dotnet-tools.json, not a packaged cli/ copy. -->
    <_AxialGuardrailsExe>dotnet fsharp-analyzers</_AxialGuardrailsExe>
    <!-- Only this repo sets this; a real package consumer never needs to bootstrap-build anything. -->
    <_AxialGuardrailsBootstrapProject>$(MSBuildThisFileDirectory)src\Axial.Guardrails\Axial.Guardrails.fsproj</_AxialGuardrailsBootstrapProject>
    <_AxialGuardrailsPolicyToolAssembly>$(MSBuildThisFileDirectory)artifacts\bin\Axial.Tool\$(Configuration.ToLower())\Axial.Tool.dll</_AxialGuardrailsPolicyToolAssembly>
    <!-- Axial's rules see the same active source in both TFMs (its conditionals distinguish only Fable).
         net8.0 also enables the stricter NativeAOT reflection rule, so its findings are a superset. -->
    <_AxialGuardrailsDesignatedTargetFramework Condition="'$(MSBuildProjectName)' == 'Axial'">net8.0</_AxialGuardrailsDesignatedTargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Axial.Guardrails' and '$(_AxialRepoSkipGuardrails)' != 'true' and '$(MSBuildProjectExtension)' == '.fsproj'">
    <_AxialGuardrailsToolManifest>$(MSBuildThisFileDirectory).config\dotnet-tools.json</_AxialGuardrailsToolManifest>
    <_AxialGuardrailsToolVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_AxialGuardrailsToolManifest)')), '&quot;fsharp-analyzers&quot;\s*:\s*\{[^}]*&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</_AxialGuardrailsToolVersion>
    <_AxialGuardrailsConfiguredToolAssembly>$([MSBuild]::NormalizePath($(NuGetPackageRoot), fsharp-analyzers, $(_AxialGuardrailsToolVersion), tools, net8.0, any, FSharp.Analyzers.Cli.dll))</_AxialGuardrailsConfiguredToolAssembly>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Axial.Guardrails' and '$(_AxialRepoSkipGuardrails)' != 'true' and '$(MSBuildProjectExtension)' == '.fsproj'">
    <_AxialGuardrailsConfiguredToolInput Include="$(_AxialGuardrailsToolManifest)" />
    <_AxialGuardrailsConfiguredToolInput Include="$([System.IO.Path]::GetDirectoryName('$(_AxialGuardrailsConfiguredToolAssembly)'))\*.*" />
  </ItemGroup>

  <Target Name="AxialGuardrailsEnsurePolicyTool"
          BeforeTargets="AxialGuardrailsCheckPolicy"
          Condition="'$(MSBuildProjectName)' != 'Axial.Guardrails' and '$(_AxialRepoSkipGuardrails)' != 'true' and !Exists('$(_AxialGuardrailsPolicyToolAssembly)')">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)src\Axial.Tool\Axial.Tool.fsproj&quot; -c $(Configuration) --nologo -v quiet" />
  </Target>

  <Target Name="AxialGuardrailsValidateConfiguredTool"
          BeforeTargets="AxialGuardrailsWriteInputFingerprint"
          Condition="'$(MSBuildProjectName)' != 'Axial.Guardrails' and '$(_AxialRepoSkipGuardrails)' != 'true' and '$(MSBuildProjectExtension)' == '.fsproj'">
    <Error Condition="'$(_AxialGuardrailsToolVersion)' == ''"
           Text="Could not find the fsharp-analyzers version in $(_AxialGuardrailsToolManifest)." />
    <Error Condition="!Exists('$(_AxialGuardrailsConfiguredToolAssembly)')"
           Text="The fsharp-analyzers CLI declared by $(_AxialGuardrailsToolManifest) was not restored at $(_AxialGuardrailsConfiguredToolAssembly). Run 'dotnet tool restore'." />
  </Target>

  <!-- Guardrails is an F# analyzer; other project types never import it. -->
  <Import Project="$(MSBuildThisFileDirectory)src\Axial.Guardrails\build\Axial.Guardrails.targets"
          Condition="'$(MSBuildProjectName)' != 'Axial.Guardrails' and '$(_AxialRepoSkipGuardrails)' != 'true' and '$(MSBuildProjectExtension)' == '.fsproj'" />

</Project>
