<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <_AxialRepoSkipGuardrails>true</_AxialRepoSkipGuardrails>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.201" PrivateAssets="all" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.201" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><Compile Include="Program.fs" /></ItemGroup>
</Project>
