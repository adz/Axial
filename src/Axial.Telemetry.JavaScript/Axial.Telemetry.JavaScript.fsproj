<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Axial.Telemetry.JavaScript</AssemblyName>
    <RootNamespace>Axial.Telemetry.JavaScript</RootNamespace>
    <PackageId>Axial.Telemetry.JavaScript</PackageId>
    <Authors>Adam Davies</Authors>
    <PackageMaturity>Experimental</PackageMaturity>
    <Description>OpenTelemetry JS tracing for Axial flows compiled with Fable: spans, fiber observability, and annotation attributes through a host-supplied @opentelemetry/api object. Node and browser; JavaScript targets only.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Axial</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fsharp;axial;flow;telemetry;tracing;opentelemetry;fable;javascript;fable-javascript</PackageTags>
    <FablePackageType>library</FablePackageType>
    <!-- Fable.Package.SDK defaults to embedded PDBs, which would leave the snupkg empty. -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Fable.Package.SDK" Version="$(FablePackageSdkVersion)" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axial\Axial.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Axial.Telemetry compiles this file too. It lives here because Fable compiles a package from the sources in
         its fable/ folder and resolves each Compile Include against that folder, so a linked file would be missing. -->
    <Compile Include="SpanConventions.fs" />
    <Compile Include="Telemetry.fs" />
  </ItemGroup>

</Project>
