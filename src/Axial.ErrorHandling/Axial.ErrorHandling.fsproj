<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <PackageId>Axial.ErrorHandling</PackageId>
    <AssemblyName>Axial.ErrorHandling</AssemblyName>
    <Authors>Adam Davies</Authors>
    <Description>Dependency-only meta-package installing Axial.Result, Axial.Constraint, and Axial.Refined together.</Description>
    <PackageProjectUrl>https://github.com/adz/Axial</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Axial</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;error-handling;result;validation;checks;refined-types</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Dependency-only meta-package: no source, no runtime assembly. dotnet pack still emits an
         empty lib output per TFM; IncludeBuildOutput=false keeps it out of the .nupkg so the package
         carries only the three NuGet dependency edges below. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Axial.Result\Axial.Result.fsproj" />
    <ProjectReference Include="..\Axial.Constraint\Axial.Constraint.fsproj" />
    <ProjectReference Include="..\Axial.Refined\Axial.Refined.fsproj" />
    <ProjectReference Include="..\Axial.Parse\Axial.Parse.fsproj" />
  </ItemGroup>
</Project>
