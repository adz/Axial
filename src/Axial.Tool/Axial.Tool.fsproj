<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>axial</ToolCommandName>
    <!-- A dotnet tool must start on a newer installed runtime instead of requiring the exact target major. -->
    <RollForward>Major</RollForward>
    <PackageId>Axial.Tool</PackageId>
    <Description>Axial repository policy and project tooling.</Description>
    <PackageMaturity>Experimental</PackageMaturity>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <!-- Slice 1c wires the v2 role-aware analyzer; this host/effects tool cannot satisfy v1 per-line boundaries. -->
    <_AxialRepoSkipGuardrails>true</_AxialRepoSkipGuardrails>
  </PropertyGroup>
  <ItemGroup>
    <None Include="FullCheck.targets" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="Command.fs" />
    <Compile Include="PolicyLock.fs" />
    <Compile Include="RawTaskCount.fs" />
    <Compile Include="PolicyReview.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The raw-Task trend reuses Fast's AXG014 visitor and policy semantics rather than a separate detector. -->
    <ProjectReference Include="../Axial.Guardrails/Axial.Guardrails.fsproj" />
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.37.2" />
    <!-- FCS requires its exact FSharp.Core, as the analyzer project pins it. -->
    <PackageReference Update="FSharp.Core" Version="10.1.201" />
  </ItemGroup>
</Project>
