<Project>
  <!-- Referencing Axial turns on its Axial.Guardrails guardrail; its rules ship in Axial.Guardrails.
       Remove it with <AxialGuardrail Remove="Axial" />, or set its severity with
       <AxialGuardrail Update="Axial" Severity="warning" />. -->
  <ItemGroup>
    <AxialGuardrail Include="Axial" />
  </ItemGroup>
</Project>
