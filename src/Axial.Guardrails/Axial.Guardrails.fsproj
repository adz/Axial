<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Axial.Guardrails.Analyzers</AssemblyName>
    <_AxialRepoSkipGuardrails>true</_AxialRepoSkipGuardrails>
    <RootNamespace>Axial.Guardrails</RootNamespace>
    <PackageId>Axial.Guardrails</PackageId>
    <Authors>Adam Davies</Authors>
    <PackageMaturity>Incubating</PackageMaturity>
    <Description>Build-time guardrails for F# code using Axial: flags ambient effects (clock, randomness, GUIDs, console, filesystem, process, environment), exceptions in flows, shared test fixtures, raw concurrency and other effect-boundary mistakes. Fast syntax advice runs on every build and never fails it on guidance; Full mode and `axial check --full` (Axial.Tool) run the complete typed checks against a checked-in, reviewed policy.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Axial</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fsharp;axial;analyzer;linter;fsharp-analyzers</PackageTags>
    <!-- This analyzer package excludes normal build output and therefore has no portable PDB payload for a symbol package. -->
    <IncludeSymbols>false</IncludeSymbols>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>true</IsPackable>
    <!-- Analyzer dlls are loaded standalone by the fsharp-analyzers CLI; they are not compiled into consumers. -->
    <IsAotCompatible>false</IsAotCompatible>
    <!--
      The fsharp-analyzers CLI loads this assembly standalone, outside our own dependency-resolution
      context, so its full transitive closure (FSharp.Analyzers.SDK.dll, FSharp.Compiler.Service.dll,
      etc.) must sit next to it on disk. This copies that closure into the build output so it can be
      packed as-is under analyzers/ below, instead of a classlib's normal reference-only output.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Consumers never compile against this assembly; only the fsharp-analyzers CLI loads it, from analyzers/. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!--
      NU5128: expected because this package intentionally has no lib/ref assemblies to compile against.
      NU5100: expected for every dll under analyzers/ and cli/ - none of them are meant to be referenced.
    -->
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <!--
      This package bundles FSharp.Analyzers.SDK, FSharp.Compiler.Service, its own FSharp.Core, and the
      fsharp-analyzers CLI in full under analyzers/ and cli/ (see _AxialGuardrailsPackAnalyzerOutput
      below). Without this, the generated .nuspec would advertise FSharp.Analyzers.SDK/FSharp.Core as
      consumer dependencies even though nothing under lib/ or ref/ is ever compiled against - causing
      NU1608 for any consumer pinning a different FSharp.Core.
    -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Releases only (scripts/pack.sh -r): the precompiled CLI folders add ~23 MB each to the package. -->
    <AxialGuardrailsPrecompileCli Condition="'$(AxialGuardrailsPrecompileCli)' == ''">false</AxialGuardrailsPrecompileCli>
    <!-- The packing SDK's runtime: ReadyToRun code is used only on a runtime of the major it was compiled against. -->
    <_AxialGuardrailsCliRuntimeVersion>$(BundledNETCoreAppPackageVersion)</_AxialGuardrailsCliRuntimeVersion>
    <_AxialGuardrailsCliRuntimeMajor>$(BundledNETCoreAppPackageVersion.Substring(0, $(BundledNETCoreAppPackageVersion.IndexOf('.'))))</_AxialGuardrailsCliRuntimeMajor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Update="FSharp.Core" Version="10.1.201" PrivateAssets="all" />
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.37.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      fsharp-analyzers is packaged as a DotnetTool, which NuGet refuses as an ordinary PackageReference
      (NU1212) and so cannot flow as a transitive dependency to consumers. PackageDownload instead
      fetches it to the local package cache at our own build/pack time only; _AxialGuardrailsPackAnalyzerOutput
      below copies its CLI dll out of that cache into our own package payload under cli/, so the
      consumer needs no tool install of their own - the CLI travels inside Axial.Guardrails itself.
    -->
    <PackageDownload Include="fsharp-analyzers" Version="[0.37.2]" />
    <!--
      Pack also ships that CLI precompiled (ReadyToRun) for linux-x64 and win-x64, under cli/<rid>-net<major>/: a Full
      check otherwise JIT-compiles the compiler service in every process (~12% of a Full run on Axial). The runtime
      ignores ReadyToRun code compiled against another major, so the folder names the packing SDK's runtime major and
      the targets use it only on a match; anything else runs the portable cli/ copy, correct but slower.
    -->
    <PackageDownload Include="Microsoft.NETCore.App.Crossgen2.$(NETCoreSdkPortableRuntimeIdentifier)" Condition="'$(AxialGuardrailsPrecompileCli)' == 'true'" Version="[$(_AxialGuardrailsCliRuntimeVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.linux-x64" Condition="'$(AxialGuardrailsPrecompileCli)' == 'true'" Version="[$(_AxialGuardrailsCliRuntimeVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.win-x64" Condition="'$(AxialGuardrailsPrecompileCli)' == 'true'" Version="[$(_AxialGuardrailsCliRuntimeVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="EffectCatalog.fs" />
    <Compile Include="Policy.fs" />
    <Compile Include="GuardrailConfig.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="SymbolIndex.fs" />
    <Compile Include="Suppressions.fs" />
    <Compile Include="TaskSurfaceSyntax.fs" />
    <Compile Include="RaiseInFlowAnalyzer.fs" />
    <Compile Include="EffectBoundaryAnalyzer.fs" />
    <Compile Include="ResourceFromFiberAnalyzer.fs" />
    <Compile Include="ScopeFromRunAnalyzer.fs" />
    <Compile Include="WaitForFactsAnalyzer.fs" />
    <Compile Include="FixtureSyntax.fs" />
    <Compile Include="FixtureAnalyzer.fs" />
    <Compile Include="DiscardedCancellationAnalyzer.fs" />
    <Compile Include="ReflectionFormattingAnalyzer.fs" />
    <Compile Include="ConcurrencyHazardsAnalyzer.fs" />
    <Compile Include="FastSyntax.fs" />
    <Compile Include="TaskSurfaceAnalyzer.fs" />
    <Compile Include="SuppressionIntegrityAnalyzer.fs" />
    <Compile Include="FastRunner.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Axial.Guardrails.props" Pack="true" PackagePath="build\" />
    <None Include="build\Axial.Guardrails.targets" Pack="true" PackagePath="build\" />
    <ProjectReference Include="../Axial.Guardrails.Build/Axial.Guardrails.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Bundle the built analyzer assembly and its full dependency closure (see CopyLocalLockFileAssemblies
    above) into the package under analyzers/, so build/Axial.Guardrails.targets can point the CLI's
    analyzers path flag at it directly. Runs at pack time, after Build has populated $(TargetDir).
  -->
  <ItemGroup>
    <_AxialGuardrailsCliPlatform Include="linux-x64" TargetOs="linux" />
    <_AxialGuardrailsCliPlatform Include="win-x64" TargetOs="windows" />
    <!-- The assemblies a Full check spends its JIT time in; the rest stay IL to keep each folder small. -->
    <_AxialGuardrailsCliHot Include="$(NuGetPackageRoot)fsharp-analyzers\0.37.2\tools\net8.0\any\FSharp.Compiler.Service.dll;$(NuGetPackageRoot)fsharp-analyzers\0.37.2\tools\net8.0\any\FSharp.Core.dll;$(NuGetPackageRoot)fsharp-analyzers\0.37.2\tools\net8.0\any\FSharp.Analyzers.SDK.dll;$(NuGetPackageRoot)fsharp-analyzers\0.37.2\tools\net8.0\any\FSharp.Analyzers.Cli.dll" />
  </ItemGroup>

  <Target Name="_AxialGuardrailsCliImages" Condition="'$(AxialGuardrailsPrecompileCli)' == 'true'">
    <ItemGroup>
      <_AxialGuardrailsCliHotSource Include="@(_AxialGuardrailsCliHot)" Source="%(FullPath)" />
      <!-- Every hot assembly for every platform (batching over the platforms). -->
      <_AxialGuardrailsCliJob Include="@(_AxialGuardrailsCliHotSource)" Platform="%(_AxialGuardrailsCliPlatform.Identity)" TargetOs="%(_AxialGuardrailsCliPlatform.TargetOs)" />
      <_AxialGuardrailsCliImage Include="@(_AxialGuardrailsCliJob->'$(IntermediateOutputPath)cli-r2r\%(Platform)-net$(_AxialGuardrailsCliRuntimeMajor)\%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!-- One crossgen2 run per platform and hot assembly; incremental, so repeated packs reuse the images. -->
  <Target Name="_AxialGuardrailsCliReadyToRun" Condition="'$(AxialGuardrailsPrecompileCli)' == 'true'" DependsOnTargets="_AxialGuardrailsCliImages" Inputs="@(_AxialGuardrailsCliImage->'%(Source)')" Outputs="@(_AxialGuardrailsCliImage)">
    <PropertyGroup>
      <_AxialGuardrailsCrossgen>$(NuGetPackageRoot)microsoft.netcore.app.crossgen2.$(NETCoreSdkPortableRuntimeIdentifier.ToLowerInvariant())/$(_AxialGuardrailsCliRuntimeVersion)/tools/crossgen2</_AxialGuardrailsCrossgen>
      <_AxialGuardrailsCrossgen Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(_AxialGuardrailsCrossgen).exe</_AxialGuardrailsCrossgen>
      <_AxialGuardrailsRuntimePacks>$(NuGetPackageRoot)microsoft.netcore.app.runtime.</_AxialGuardrailsRuntimePacks>
    </PropertyGroup>
    <MakeDir Directories="@(_AxialGuardrailsCliImage->'%(RootDir)%(Directory)')" />
    <Exec Command="&quot;$(_AxialGuardrailsCrossgen)&quot; &quot;%(_AxialGuardrailsCliImage.Source)&quot; -o &quot;%(_AxialGuardrailsCliImage.FullPath)&quot; -r &quot;$(_AxialGuardrailsRuntimePacks)%(Platform)/$(_AxialGuardrailsCliRuntimeVersion)/runtimes/%(Platform)/lib/net$(_AxialGuardrailsCliRuntimeMajor).0/*.dll&quot; -r &quot;$(NuGetPackageRoot)fsharp-analyzers/0.37.2/tools/net8.0/any/*.dll&quot; --targetos %(TargetOs) --targetarch x64 -O" StandardOutputImportance="low" />
  </Target>

  <Target Name="_AxialGuardrailsPackAnalyzerOutput" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build;_AxialGuardrailsCliReadyToRun">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Axial.Tool\Axial.Tool.fsproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\bin\Axial.Guardrails.Build\$(Configuration.ToLower())\Axial.Guardrails.Build.dll" Pack="true" PackagePath="tasks\" />
      <_AxialGuardrailsAnalyzerFile Include="$(TargetDir)*.dll" />
      <None Include="@(_AxialGuardrailsAnalyzerFile)" Pack="true" PackagePath="analyzers\%(Filename)%(Extension)" />
      <_AxialGuardrailsCliFile Include="$(NuGetPackageRoot)fsharp-analyzers\0.37.2\tools\net8.0\any\*.*" />
      <None Include="@(_AxialGuardrailsCliFile)" Pack="true" PackagePath="cli\%(Filename)%(Extension)" />
      <!-- Each precompiled folder is the portable CLI with its hot assemblies replaced. -->
      <_AxialGuardrailsCliCopy Include="@(_AxialGuardrailsCliFile)" Exclude="@(_AxialGuardrailsCliHot)" Platform="%(_AxialGuardrailsCliPlatform.Identity)" Condition="'$(AxialGuardrailsPrecompileCli)' == 'true'" />
      <_AxialGuardrailsCliCopy Include="@(_AxialGuardrailsCliImage)" Condition="'$(AxialGuardrailsPrecompileCli)' == 'true'" />
      <_AxialGuardrailsCliCopy>
        <PackagePath>cli\%(Platform)-net$(_AxialGuardrailsCliRuntimeMajor)\%(Filename)%(Extension)</PackagePath>
      </_AxialGuardrailsCliCopy>
      <None Include="@(_AxialGuardrailsCliCopy)" Pack="true" />
      <_AxialGuardrailsPolicyToolFile Include="$(MSBuildThisFileDirectory)..\..\artifacts\bin\Axial.Tool\$([System.String]::Copy('$(Configuration)').ToLowerInvariant())\**\*.*" />
      <None Include="@(_AxialGuardrailsPolicyToolFile)" Pack="true" PackagePath="policy\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
