<Project>

  <PropertyGroup>
    <!-- Set to false to skip the analyzer for this project entirely. -->
    <AxialGuardrailsEnabled Condition="'$(AxialGuardrailsEnabled)' == ''">true</AxialGuardrailsEnabled>
    <!-- "warning" (default) reports findings without failing the build; "error" fails it. -->
    <!-- AXIAL_GUARDRAILS_SEVERITY, if set in the environment, overrides the default. It applies only
         when AxialGuardrailsSeverity is still empty, so a project property or a -p:AxialGuardrailsSeverity
         command-line property wins over the environment. -->
    <AxialGuardrailsSeverity Condition="'$(AxialGuardrailsSeverity)' == '' and '$(AXIAL_GUARDRAILS_SEVERITY)' != ''">$(AXIAL_GUARDRAILS_SEVERITY)</AxialGuardrailsSeverity>
    <AxialGuardrailsSeverity Condition="'$(AxialGuardrailsSeverity)' == ''">warning</AxialGuardrailsSeverity>
  </PropertyGroup>

</Project>
