<Project>

  <PropertyGroup>
    <!-- Set in a project file only when that project cannot run analyzers. CI rejects the environment-variable form. -->
    <AxialGuardrailsEnabled Condition="'$(AxialGuardrailsEnabled)' == ''">true</AxialGuardrailsEnabled>
    <!-- Findings are errors by default. A checked-in baseline is the only supported downgrade path. -->
    <AxialGuardrailsBaselineFile Condition="'$(AxialGuardrailsBaselineFile)' == ''">$(MSBuildProjectDirectory)\Axial.Guardrails.baseline</AxialGuardrailsBaselineFile>
  </PropertyGroup>

</Project>
