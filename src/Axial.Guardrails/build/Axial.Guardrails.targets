<Project>
  <PropertyGroup>
    <_AxialGuardrailsTaskAssembly Condition="'$(_AxialGuardrailsTaskAssembly)' == ''">$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), .., tasks, Axial.Guardrails.Build.dll))</_AxialGuardrailsTaskAssembly>
  </PropertyGroup>
  <UsingTask TaskName="AxialGuardrailsTask" AssemblyFile="$(_AxialGuardrailsTaskAssembly)" />
  <PropertyGroup>
    <!-- Infrastructure is not a compiler diagnostic, including with MSBuild -warnaserror. -->
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);AXGINF001</MSBuildWarningsNotAsErrors>
    <AxialGuardrailsTimings Condition="'$(AxialGuardrailsTimings)' == ''">false</AxialGuardrailsTimings>
    <_AxialGuardrailsForce>false</_AxialGuardrailsForce>
    <_AxialGuardrailsFingerprintMilliseconds>0</_AxialGuardrailsFingerprintMilliseconds>
    <_AxialGuardrailsRules>EffectBoundary;RaiseInFlow;Fixture;DiscardedCancellation;ReflectionFormatting;ResourceFromFiber;ScopeFromRun;RawConcurrency;SwallowedException;UncancellableWork;DiscardedWork;WaitForFacts;SuppressionIntegrity</_AxialGuardrailsRules>
  </PropertyGroup>

  <!-- Not stamped: an obsolete setting must be visible on every build, including incremental rebuilds and builds
       where analysis is disabled. The outer cross-targeting invocation skips this; each inner project rejects the setting. -->
  <Target Name="AxialGuardrailsRejectRemovedSeverity"
          BeforeTargets="Build"
          Condition="'$(_AxialGuardrailsRemovedSeverityWarned)' != 'true' and ('$(TargetFramework)' != '' or '$(TargetFrameworks)' == '') and ('$(AxialGuardrailsSeverity)' != '' or '$(AXIAL_GUARDRAILS_SEVERITY)' != '')">
    <Error Code="AXIALGR001"
           Text="AxialGuardrailsSeverity / AXIAL_GUARDRAILS_SEVERITY is removed in Axial 0.12. Remove it and configure supported per-role rule levels in Axial.Guardrails.toml. See the policy-roles migration row in the 0.12.0 release notes (dev-docs/releases/0.12.0.md#policy-roles). AXG009-013 retain their fixed block/guide policy; AxialGuardrailsCheckpoint controls unacknowledged guides at checkpoints." />
    <PropertyGroup>
      <_AxialGuardrailsRemovedSeverityWarned>true</_AxialGuardrailsRemovedSeverityWarned>
    </PropertyGroup>
  </Target>

  <PropertyGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <!--
      A caller that imports this file directly (rather than getting it via PackageReference) can
      set _AxialGuardrailsAnalyzersPath and _AxialGuardrailsExe before importing, to point at a
      locally built analyzer and locally installed CLI instead of the packaged analyzers/ and
      cli/ folders. Axial's own repo does exactly this in Directory.Build.targets, so its own
      build runs the identical check a package consumer gets, with no separate script.
    -->
    <_AxialGuardrailsAnalyzersPath Condition="'$(_AxialGuardrailsAnalyzersPath)' == ''">$(MSBuildThisFileDirectory)..\analyzers</_AxialGuardrailsAnalyzersPath>
    <_AxialGuardrailsToolPath Condition="'$(_AxialGuardrailsToolPath)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..\cli))</_AxialGuardrailsToolPath>
    <_AxialGuardrailsToolAssembly Condition="'$(_AxialGuardrailsToolAssembly)' == ''">$([MSBuild]::NormalizePath($(_AxialGuardrailsToolPath), FSharp.Analyzers.Cli.dll))</_AxialGuardrailsToolAssembly>
    <_AxialGuardrailsUsesPackagedTool Condition="'$(_AxialGuardrailsExe)' == ''">true</_AxialGuardrailsUsesPackagedTool>
    <_AxialGuardrailsExe Condition="'$(_AxialGuardrailsExe)' == ''">dotnet &quot;$(_AxialGuardrailsToolAssembly)&quot;</_AxialGuardrailsExe>
    <!--
      AXG001–008 retain their baseline behavior. Tiered rules are scoped by role: block findings are errors;
      guide findings warn, or remain visible as Info when acknowledged. Checked-in verification/release scripts
      set AxialGuardrailsCheckpoint to reject unacknowledged guides and invalid notes. The CLI's treat-as-error
      option would also promote acknowledged Info, so severity is resolved in the analyzer using the rules file.

      Test projects run Fixture, WaitForFacts, RawConcurrency and SuppressionIntegrity by default: ambient effect rules flag File and DateTimeOffset
      that tests legitimately use for setup and assertions. Set AxialGuardrailsInTests to all to
      run every enabled guardrail in a test-role project. The checked-in policy, not the test SDK,
      declares that role; analyzers resolve it in-process from their existing policy input.
    -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <!-- The task validates content-keyed coverage and replays diagnostics on every build.
         MSBuild timestamp skipping alone cannot validate a structured report or replay its findings. -->
    <!-- Cross-targeting builds can evaluate IntermediateOutputPath before the SDK appends the target framework.
         Keep analyzer state per framework explicitly: sharing these files lets one TFM suppress another and lets
         concurrent analyzer processes contend over the same config and stamp. -->
    <_AxialGuardrailsStampFile>$(IntermediateOutputPath)axial-guardrails.$(TargetFramework).stamp</_AxialGuardrailsStampFile>
    <_AxialGuardrailsConfigFile>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), axial-guardrails.$(TargetFramework).rules))</_AxialGuardrailsConfigFile>
    <_AxialGuardrailsFingerprintFile>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), axial-guardrails.$(TargetFramework).inputs))</_AxialGuardrailsFingerprintFile>
    <_AxialGuardrailsFscArgsFile>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), axial-guardrails.$(TargetFramework).fscargs))</_AxialGuardrailsFscArgsFile>
    <!-- Reuse the command line CoreCompile already resolved instead of making the analyzer CLI evaluate MSBuild again. -->
    <ProvideCommandLineArgs>true</ProvideCommandLineArgs>
    <_AxialGuardrailsPolicyRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), Axial.Guardrails.toml))</_AxialGuardrailsPolicyRoot>
    <_AxialGuardrailsPolicyFile Condition="'$(_AxialGuardrailsPolicyRoot)' != ''">$([MSBuild]::NormalizePath($(_AxialGuardrailsPolicyRoot), Axial.Guardrails.toml))</_AxialGuardrailsPolicyFile>
    <_AxialGuardrailsLockFile Condition="'$(_AxialGuardrailsPolicyRoot)' != ''">$([MSBuild]::NormalizePath($(_AxialGuardrailsPolicyRoot), Axial.Guardrails.lock))</_AxialGuardrailsLockFile>
    <_AxialGuardrailsV2BaselineRelative Condition="Exists('$(_AxialGuardrailsPolicyFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_AxialGuardrailsPolicyFile)')), '(?m)^\s*baseline\s*=\s*&quot;([^&quot;]+)&quot;\s*$').Groups[1].Value)</_AxialGuardrailsV2BaselineRelative>
    <AxialGuardrailsBaselineFile Condition="'$(_AxialGuardrailsV2BaselineRelative)' != ''">$([MSBuild]::NormalizePath($(_AxialGuardrailsPolicyRoot), $(_AxialGuardrailsV2BaselineRelative)))</AxialGuardrailsBaselineFile>
    <_AxialGuardrailsBaselineRoot Condition="'$(_AxialGuardrailsPolicyRoot)' != ''">$(_AxialGuardrailsPolicyRoot)</_AxialGuardrailsBaselineRoot>
    <_AxialGuardrailsPolicyGlobRoot Condition="'$(_AxialGuardrailsPolicyRoot)' != ''">$(_AxialGuardrailsPolicyRoot)</_AxialGuardrailsPolicyGlobRoot>
    <_AxialGuardrailsPolicyGlobRoot Condition="'$(_AxialGuardrailsPolicyGlobRoot)' == ''">$(MSBuildProjectDirectory)</_AxialGuardrailsPolicyGlobRoot>
    <_AxialGuardrailsPolicyCheckStamp>$(IntermediateOutputPath)axial-guardrails-policy.$(TargetFramework).stamp</_AxialGuardrailsPolicyCheckStamp>
    <_AxialGuardrailsPolicyFingerprintFile>$(IntermediateOutputPath)axial-guardrails-policy.$(TargetFramework).inputs</_AxialGuardrailsPolicyFingerprintFile>
    <_AxialGuardrailsPolicyToolAssembly Condition="'$(_AxialGuardrailsPolicyToolAssembly)' == ''">$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory)..\policy\Axial.Tool.dll))</_AxialGuardrailsPolicyToolAssembly>
    <_AxialGuardrailsDotNetHost Condition="'$(_AxialGuardrailsDotNetHost)' == '' and '$(DotNetHostPath)' != ''">&quot;$(DotNetHostPath)&quot;</_AxialGuardrailsDotNetHost>
    <_AxialGuardrailsDotNetHost Condition="'$(_AxialGuardrailsDotNetHost)' == ''">dotnet</_AxialGuardrailsDotNetHost>
    <_AxialGuardrailsPolicyExe Condition="'$(_AxialGuardrailsPolicyExe)' == ''">$(_AxialGuardrailsDotNetHost) --roll-forward LatestMajor &quot;$(_AxialGuardrailsPolicyToolAssembly)&quot;</_AxialGuardrailsPolicyExe>
  </PropertyGroup>

  <ItemGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <_AxialGuardrailsPolicyInputs Include="$(MSBuildProjectFullPath);$(MSBuildAllProjects)" />
    <_AxialGuardrailsPolicyInputs Include="$(AxialGuardrailsBaselineFile)" Condition="Exists('$(AxialGuardrailsBaselineFile)')" />
    <_AxialGuardrailsPolicyInputs Include="$(_AxialGuardrailsPolicyFile);$(_AxialGuardrailsLockFile)" Condition="'$(_AxialGuardrailsPolicyRoot)' != ''" />
    <_AxialGuardrailsProtectedInputs Include="$(_AxialGuardrailsPolicyGlobRoot)\Directory.Build.props;$(_AxialGuardrailsPolicyGlobRoot)\Directory.Build.targets;$(_AxialGuardrailsPolicyGlobRoot)\**\*.props;$(_AxialGuardrailsPolicyGlobRoot)\**\*.targets;$(_AxialGuardrailsPolicyGlobRoot)\**\.editorconfig;$(_AxialGuardrailsPolicyGlobRoot)\**\*.globalconfig;$(_AxialGuardrailsPolicyGlobRoot)\tests\Axial.Guardrails*\**\*.fs;$(_AxialGuardrailsPolicyGlobRoot)\tests\Axial.Guardrails*\**\*.fsproj" Condition="'$(_AxialGuardrailsPolicyRoot)' != ''" Exclude="$(_AxialGuardrailsPolicyGlobRoot)\**\bin\**;$(_AxialGuardrailsPolicyGlobRoot)\**\obj\**;$(_AxialGuardrailsPolicyGlobRoot)\artifacts\**" />
    <_AxialGuardrailsPolicyInputs Include="@(_AxialGuardrailsProtectedInputs)" />
    <_AxialGuardrailsPolicyInputs Include="$(ProjectAssetsFile)" Condition="Exists('$(ProjectAssetsFile)')" />
    <_AxialGuardrailsPolicyInputs Include="@(EditorConfigFiles);@(AnalyzerConfigFiles)" />
  </ItemGroup>

  <!-- Capture these after Build: generators and reference resolution can add items after project evaluation. The two
       SDK assembly-attribute files are timestamp-volatile but semantically represented by the fingerprint below. -->
  <!-- The checked-in v2 policy is authoritative. The lock check runs before analyzer configuration and emits the
       same loud categorized summary in every environment. -->
  <Target Name="AxialGuardrailsValidatePolicyCache"
          BeforeTargets="AxialGuardrailsCheckPolicy"
          Condition="'$(AxialGuardrailsEnabled)' == 'true' and '$(_AxialGuardrailsPolicyRoot)' != ''">
    <ItemGroup>
      <_AxialGuardrailsExistingPolicyInput Include="@(_AxialGuardrailsPolicyInputs)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
    <GetFileHash Files="@(_AxialGuardrailsExistingPolicyInput)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_AxialGuardrailsPolicyInputHash" />
    </GetFileHash>
    <ItemGroup>
      <_AxialGuardrailsPolicyFingerprintLine Include="@(_AxialGuardrailsPolicyInputHash->'%(FullPath)|%(FileHash)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_AxialGuardrailsPolicyFingerprintFile)" Lines="@(_AxialGuardrailsPolicyFingerprintLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <GetFileHash Files="$(_AxialGuardrailsPolicyFingerprintFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_AxialGuardrailsPolicyFingerprintHash" />
    </GetFileHash>
    <ReadLinesFromFile File="$(_AxialGuardrailsPolicyCheckStamp)" Condition="Exists('$(_AxialGuardrailsPolicyCheckStamp)')">
      <Output TaskParameter="Lines" ItemName="_AxialGuardrailsCachedPolicyFingerprintHash" />
    </ReadLinesFromFile>
    <Delete Files="$(_AxialGuardrailsPolicyCheckStamp)"
            Condition="Exists('$(_AxialGuardrailsPolicyCheckStamp)') and '@(_AxialGuardrailsCachedPolicyFingerprintHash)' != '@(_AxialGuardrailsPolicyFingerprintHash->'%(FileHash)')'" />
  </Target>

  <Target Name="AxialGuardrailsCheckPolicy"
          BeforeTargets="AxialGuardrailsWriteConfig"
          Condition="'$(AxialGuardrailsEnabled)' == 'true' and '$(_AxialGuardrailsPolicyRoot)' != ''"
          Inputs="@(_AxialGuardrailsPolicyInputs);$(_AxialGuardrailsPolicyToolAssembly)"
          Outputs="$(_AxialGuardrailsPolicyCheckStamp)">
    <Error Condition="!Exists('$(_AxialGuardrailsPolicyToolAssembly)')" Text="Axial.Guardrails policy tool is missing: $(_AxialGuardrailsPolicyToolAssembly). Restore/reinstall the package." />
    <Exec Command="$(_AxialGuardrailsPolicyExe) check" WorkingDirectory="$(_AxialGuardrailsPolicyRoot)"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=LatestMajor" />
    <WriteLinesToFile File="$(_AxialGuardrailsPolicyCheckStamp)" Lines="@(_AxialGuardrailsPolicyFingerprintHash->'%(FileHash)')" Overwrite="true" />
  </Target>

  <Target Name="AxialGuardrailsWriteInputFingerprint"
          BeforeTargets="AxialGuardrailsEffectBoundaryCheck"
          DependsOnTargets="AxialGuardrailsEnsureBuilt;AxialGuardrailsWriteConfig"
          Condition="'$(AxialGuardrailsEnabled)' == 'true' and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' != '')">
    <PropertyGroup Condition="'$(AxialGuardrailsTimings)' == 'true'">
      <_AxialGuardrailsFingerprintStart>$([System.DateTime]::UtcNow.Ticks)</_AxialGuardrailsFingerprintStart>
    </PropertyGroup>
    <WriteLinesToFile File="$(_AxialGuardrailsFscArgsFile)" Lines="@(FscCommandLineArgs)" Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'@(FscCommandLineArgs)' != ''" />
    <Error Condition="'$(_AxialGuardrailsUsesPackagedTool)' != 'true' and '@(_AxialGuardrailsConfiguredToolInput)' == ''"
           Text="An overridden _AxialGuardrailsExe requires _AxialGuardrailsConfiguredToolInput items naming its manifest and assemblies." />
    <ItemGroup>
      <_AxialGuardrailsSourceInputs Include="@(Compile)" />
      <_AxialGuardrailsSourceInputs Remove="$(GeneratedAssemblyInfoFile);$(TargetFrameworkMonikerAssemblyAttributesPath)" />
      <_AxialGuardrailsVolatileSource Include="$(GeneratedAssemblyInfoFile);$(TargetFrameworkMonikerAssemblyAttributesPath)" Condition="Exists('%(Identity)')" />
      <!-- Match CoreCompile's inputs: project references use stable reference assemblies when available. -->
      <_AxialGuardrailsReferenceInputs Include="@(ReferencePathWithRefAssemblies);@(ReferencePath)" />
    </ItemGroup>
    <GetFileHash Files="@(_AxialGuardrailsSourceInputs)" Algorithm="SHA256" Condition="'@(_AxialGuardrailsSourceInputs)' != ''">
      <Output TaskParameter="Items" ItemName="_AxialGuardrailsSourceHash" />
    </GetFileHash>
    <GetFileHash Files="@(_AxialGuardrailsVolatileSource)" Algorithm="SHA256" Condition="'@(_AxialGuardrailsVolatileSource)' != ''">
      <Output TaskParameter="Items" ItemName="_AxialGuardrailsVolatileSourceHash" />
    </GetFileHash>
    <!-- Reference outputs may be rewritten with a fresh timestamp by an otherwise no-op project-reference build.
         Hash their deterministic contents so that such rewrites do not invalidate the analysis result. -->
    <AxialGuardrailsTask Action="Hash" Files="@(_AxialGuardrailsReferenceInputs);@(_AxialGuardrailsToolInputs)" Memoize="true" MemoFile="$(IntermediateOutputPath)axial-guardrails.$(TargetFramework).digests.xml">
      <Output TaskParameter="Hashed" ItemName="_AxialGuardrailsReferenceHash" />
    </AxialGuardrailsTask>
    <ItemGroup>
      <_AxialGuardrailsContentInputs Include="@(_AxialGuardrailsPolicyInputs);@(EditorConfigFiles);@(AnalyzerConfigFiles);$(_AxialGuardrailsConfigFile)" Condition="Exists('%(Identity)')" />
      <_AxialGuardrailsContentInputs Include="$(_AxialGuardrailsFscArgsFile)" Condition="Exists('$(_AxialGuardrailsFscArgsFile)')" />

    </ItemGroup>
    <GetFileHash Files="@(_AxialGuardrailsContentInputs)" Algorithm="SHA256" Condition="'@(_AxialGuardrailsContentInputs)' != ''">
      <Output TaskParameter="Items" ItemName="_AxialGuardrailsContentHash" />
    </GetFileHash>
    <ItemGroup>
      <_AxialGuardrailsFingerprintLine Include="Schema=1-full" />
      <_AxialGuardrailsFingerprintLine Include="Rules=$(_AxialGuardrailsRules)" />
      <_AxialGuardrailsFingerprintLine Include="TargetFramework=$(TargetFramework)" />
      <_AxialGuardrailsFingerprintLine Include="AxialGuardrailsInTests=$(AxialGuardrailsInTests)" />
      <_AxialGuardrailsFingerprintLine Include="DefineConstants=$(DefineConstants)" />
      <_AxialGuardrailsFingerprintLine Include="LangVersion=$(LangVersion)" />
      <_AxialGuardrailsFingerprintLine Include="TreatWarningsAsErrors=$(TreatWarningsAsErrors)" />
      <_AxialGuardrailsFingerprintLine Include="WarningsAsErrors=$(WarningsAsErrors)" />
      <_AxialGuardrailsFingerprintLine Include="WarningsNotAsErrors=$(WarningsNotAsErrors)" />
      <_AxialGuardrailsFingerprintLine Include="NoWarn=$(NoWarn)" />
      <_AxialGuardrailsFingerprintLine Include="@(_AxialGuardrailsSourceHash->'source=%(FullPath)|%(FileHash)')" />
      <_AxialGuardrailsFingerprintLine Include="@(_AxialGuardrailsReferenceHash->'reference=%(FullPath)|%(FileHash)')" />
      <_AxialGuardrailsFingerprintLine Include="@(_AxialGuardrailsContentHash->'content=%(FullPath)|%(FileHash)')" />
      <_AxialGuardrailsFingerprintLine Include="@(_AxialGuardrailsVolatileSourceHash->'volatileSource=%(FullPath)|%(FileHash)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_AxialGuardrailsFingerprintFile)" Lines="@(_AxialGuardrailsFingerprintLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <GetFileHash Files="$(_AxialGuardrailsFingerprintFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_AxialGuardrailsFingerprintHash" />
    </GetFileHash>
    <PropertyGroup Condition="'$(AxialGuardrailsTimings)' == 'true'">
      <_AxialGuardrailsFingerprintMilliseconds>$([MSBuild]::Divide($([MSBuild]::Subtract($([System.DateTime]::UtcNow.Ticks), $(_AxialGuardrailsFingerprintStart))), 10000))</_AxialGuardrailsFingerprintMilliseconds>
    </PropertyGroup>
  </Target>

  <!--
    Self-heals the case the Exists() guard below exists for: a repo (like this one) pointing
    _AxialGuardrailsAnalyzersPath at its own live build output, hit before that project has ever
    been built. Builds it once, directly - no ProjectReference, so no per-project graph-evaluation
    cost on every subsequent build (see Directory.Build.targets for why that matters). A real
    package consumer never sets _AxialGuardrailsBootstrapProject, so this never runs for them: the
    analyzer always arrives pre-built inside the restored nupkg.

    If several projects build in parallel before the folder exists, more than one of these can fire
    at once; harmless (dotnet build is idempotent), just briefly redundant.
  -->
  <Target Name="AxialGuardrailsEnsureBuilt"
          BeforeTargets="AxialGuardrailsEffectBoundaryCheck"
          Condition="'$(AxialGuardrailsEnabled)' == 'true' and '$(_AxialGuardrailsBootstrapProject)' != '' and (!Exists('$(_AxialGuardrailsAnalyzersPath)\Axial.Guardrails.Analyzers.dll') or !Exists('$(_AxialGuardrailsTaskAssembly)'))">
    <Exec Command="dotnet build &quot;$(_AxialGuardrailsBootstrapProject)&quot; --nologo -v quiet" />
  </Target>

  <!--
    Runs after each build. The task owns report validation, finding replay and the cold CLI launch.
    CLI exit 254 is ambiguous: it is accepted only with complete coverage and recorded error findings.

    If the analyzer path is still missing after AxialGuardrailsEnsureBuilt, the check fails with a package/path
    repair instruction instead of silently skipping analysis.
  -->
  <!--
    Resolves @(AxialGuardrail) and @(AxialGuardrailRule) into the rules file the analyzers read (see
    GuardrailConfig.fs for the format). WriteOnlyWhenDifferent keeps its timestamp stable, so the check below reruns
    only when the configuration or the sources change. Metadata must not contain semicolons; escape them as %3B.
  -->
  <Target Name="AxialGuardrailsWriteConfig"
          BeforeTargets="AxialGuardrailsEffectBoundaryCheck"
          Condition="'$(AxialGuardrailsEnabled)' == 'true' and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' != '')">
    <PropertyGroup Condition="'$(_AxialGuardrailsBaselineProposalDirectory)' != ''">
      <_AxialGuardrailsProposalProject>$([System.IO.Path]::GetRelativePath('$(_AxialGuardrailsPolicyRoot)', '$(MSBuildProjectFullPath)'))</_AxialGuardrailsProposalProject>
      <_AxialGuardrailsProposalFile>$([System.IO.Path]::Combine('$(_AxialGuardrailsBaselineProposalDirectory)', '$(_AxialGuardrailsProposalProject).$(TargetFramework).baseline'))</_AxialGuardrailsProposalFile>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_AxialGuardrailsProposalFile)'))" Condition="'$(_AxialGuardrailsProposalFile)' != ''" />
    <WriteLinesToFile File="$(_AxialGuardrailsProposalFile)" Lines="" Overwrite="true" Condition="'$(_AxialGuardrailsProposalFile)' != ''" />
    <ReadLinesFromFile File="$(AxialGuardrailsBaselineFile)" Condition="Exists('$(AxialGuardrailsBaselineFile)')">
      <Output TaskParameter="Lines" ItemName="_AxialGuardrailsBaselineEntry" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_AxialGuardrailsConfigLine Include="@(AxialGuardrail->'guardrail&#9;%(Identity)')" />
      <_AxialGuardrailsConfigLine Include="@(_AxialGuardrailsBaselineEntry->'baseline&#9;%(Identity)')" />
      <_AxialGuardrailsConfigLine Include="setting&#9;checkpoint&#9;$(AxialGuardrailsCheckpoint)" />
      <_AxialGuardrailsConfigLine Include="setting&#9;inTests&#9;$(AxialGuardrailsInTests)" />
      <_AxialGuardrailsConfigLine Include="setting&#9;baselineOutput&#9;$(_AxialGuardrailsProposalFile)" Condition="'$(_AxialGuardrailsProposalFile)' != ''" />
      <_AxialGuardrailsConfigLine Include="setting&#9;baselineRule&#9;$(_AxialGuardrailsBaselineRuleCode)" Condition="'$(_AxialGuardrailsProposalFile)' != ''" />
      <_AxialGuardrailsConfigLine Include="setting&#9;baselineRoot&#9;$(_AxialGuardrailsBaselineRoot)" />
      <_AxialGuardrailsConfigLine Include="setting&#9;policyRoot&#9;$(_AxialGuardrailsPolicyRoot)" Condition="'$(_AxialGuardrailsPolicyRoot)' != ''" />
      <_AxialGuardrailsConfigLine Include="setting&#9;policyFile&#9;$(_AxialGuardrailsPolicyFile)" Condition="'$(_AxialGuardrailsPolicyRoot)' != ''" />
      <_AxialGuardrailsConfigLine Include="setting&#9;projectPath&#9;$(MSBuildProjectFullPath)" Condition="'$(_AxialGuardrailsPolicyRoot)' != ''" />
      <_AxialGuardrailsConfigLine Include="setting&#9;nativeAot&#9;true" Condition="'$(IsAotCompatible)' == 'true' or '$(PublishAot)' == 'true'" />
      <_AxialGuardrailsConfigLine Include="setting&#9;nativeAot&#9;false" Condition="'$(IsAotCompatible)' != 'true' and '$(PublishAot)' != 'true'" />
      <_AxialGuardrailsConfigLine Include="@(AxialGuardrailRule->'rule&#9;%(Identity)&#9;%(Guardrail)&#9;%(Category)&#9;%(Match)&#9;%(Scope)&#9;%(Message)&#9;%(Replacement)')" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <WriteLinesToFile File="$(_AxialGuardrailsConfigFile)" Lines="@(_AxialGuardrailsConfigLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Analyzer and the exact CLI installation are inputs: changing either must invalidate a successful result. An
       overridden command cannot be inferred safely, so its importer must identify the manifest/assemblies it uses. -->
  <ItemGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <_AxialGuardrailsToolInputs Include="$(_AxialGuardrailsAnalyzersPath)\*.dll" />
    <_AxialGuardrailsToolInputs Include="$(_AxialGuardrailsToolPath)*.dll" Condition="'$(_AxialGuardrailsUsesPackagedTool)' == 'true'" />
    <_AxialGuardrailsToolInputs Include="@(_AxialGuardrailsConfiguredToolInput);$(_AxialGuardrailsTaskAssembly)" />
  </ItemGroup>

  <Target Name="AxialGuardrailsEffectBoundaryCheck"
          AfterTargets="Build"
          Condition="'$(AxialGuardrailsEnabled)' == 'true' and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' != '') and ('$(_AxialGuardrailsDesignatedTargetFramework)' == '' or '$(TargetFramework)' == '$(_AxialGuardrailsDesignatedTargetFramework)')"
          >
    <Error Condition="!Exists('$(_AxialGuardrailsAnalyzersPath)\Axial.Guardrails.Analyzers.dll')"
           Text="Axial.Guardrails analyzer folder is missing or incomplete: $(_AxialGuardrailsAnalyzersPath). Restore/reinstall the package or fix the configured analyzer path." />
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <PropertyGroup>
      <_AxialGuardrailsAnalysisInput Condition="'@(FscCommandLineArgs)' != ''">--fsc-args-file &quot;$(_AxialGuardrailsFscArgsFile)&quot;</_AxialGuardrailsAnalysisInput>
      <_AxialGuardrailsAnalysisInput Condition="'@(FscCommandLineArgs)' == ''">--project &quot;$(MSBuildProjectFullPath)&quot; --property TargetFramework=$(TargetFramework) --configuration $(Configuration)</_AxialGuardrailsAnalysisInput>
    </PropertyGroup>
    <!-- The CLI targets net8 but may load the building SDK's newer MSBuild assemblies during project loading.
         Override inherited Major/Disable policies only for this child, including local-tool overrides and
         policy baseline's nested builds. Major alone stays on net8 when that runtime is installed. -->
    <PropertyGroup>
      <_AxialGuardrailsProposalCoverageFile Condition="'$(_AxialGuardrailsProposalFile)' != ''">$(_AxialGuardrailsProposalFile).coverage.xml</_AxialGuardrailsProposalCoverageFile>
      <_AxialGuardrailsForce Condition="'$(AxialGuardrailsCheckpoint)' == 'true' or '$(_AxialGuardrailsBaselineProposalDirectory)' != ''">true</_AxialGuardrailsForce>
    </PropertyGroup>
    <AxialGuardrailsTask Action="Run"
          Command="$(_AxialGuardrailsExe) $(_AxialGuardrailsAnalysisInput) --analyzers-path &quot;$(_AxialGuardrailsAnalyzersPath)&quot; --code-root &quot;$(MSBuildProjectDirectory)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConfigFile="$(_AxialGuardrailsConfigFile)"
          Files="@(Compile)" Rules="$(_AxialGuardrailsRules)"
          RequestInputs="@(_AxialGuardrailsSourceHash);@(_AxialGuardrailsVolatileSourceHash);@(_AxialGuardrailsReferenceHash);@(_AxialGuardrailsContentHash)" Fingerprint="@(_AxialGuardrailsFingerprintHash->'%(FileHash)')"
          StampFile="$(_AxialGuardrailsStampFile)" ResultFile="$(IntermediateOutputPath)axial-guardrails.$(TargetFramework).result.xml"
          Timings="$(AxialGuardrailsTimings)" TimingsFile="$(IntermediateOutputPath)axial-guardrails.$(TargetFramework).timings.xml"
          CoverageFile="$(_AxialGuardrailsProposalCoverageFile)"
          FingerprintMilliseconds="$(_AxialGuardrailsFingerprintMilliseconds)" Force="$(_AxialGuardrailsForce)" />
  </Target>

</Project>
