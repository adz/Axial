<Project>

  <PropertyGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <!--
      A caller that imports this file directly (rather than getting it via PackageReference) can
      set _AxialGuardrailsAnalyzersPath and _AxialGuardrailsExe before importing, to point at a
      locally built analyzer and locally installed CLI instead of the packaged analyzers/ and
      cli/ folders. Axial's own repo does exactly this in Directory.Build.targets, so its own
      build runs the identical check a package consumer gets, with no separate script.
    -->
    <AxialGuardrailsBoundaryLimit Condition="'$(AxialGuardrailsBoundaryLimit)' == ''">64</AxialGuardrailsBoundaryLimit>
    <_AxialGuardrailsAnalyzersPath Condition="'$(_AxialGuardrailsAnalyzersPath)' == ''">$(MSBuildThisFileDirectory)..\analyzers</_AxialGuardrailsAnalyzersPath>
    <_AxialGuardrailsToolPath Condition="'$(_AxialGuardrailsToolPath)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..\cli))</_AxialGuardrailsToolPath>
    <_AxialGuardrailsToolAssembly Condition="'$(_AxialGuardrailsToolAssembly)' == ''">$([MSBuild]::NormalizePath($(_AxialGuardrailsToolPath), FSharp.Analyzers.Cli.dll))</_AxialGuardrailsToolAssembly>
    <_AxialGuardrailsUsesPackagedTool Condition="'$(_AxialGuardrailsExe)' == ''">true</_AxialGuardrailsUsesPackagedTool>
    <_AxialGuardrailsExe Condition="'$(_AxialGuardrailsExe)' == ''">dotnet &quot;$(_AxialGuardrailsToolAssembly)&quot;</_AxialGuardrailsExe>
    <!--
      Findings are errors unless their stable fingerprint is in the checked-in baseline. There is no project-wide
      severity downgrade: migrations generate a baseline instead of making new violations non-failing.

      Test projects run only the Fixture analyzer by default: the effect rules flag Thread.Sleep, File and
      DateTimeOffset that tests legitimately use for setup and assertions. Set AxialGuardrailsInTests to all to
      run every enabled guardrail in a test project. $(IsTestProject) is set by Microsoft.NET.Test.Sdk.
    -->
    <_AxialGuardrailsIncludeAnalyzersFlag Condition="'$(IsTestProject)' == 'true' and '$(AxialGuardrailsInTests)' != 'all'">--include-analyzers Fixture</_AxialGuardrailsIncludeAnalyzersFlag>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <!--
      Without Inputs/Outputs, MSBuild has no way to know this target's work is already done, and
      reruns the external CLI process - a full, independent, cold project reload and re-typecheck,
      redundant with the compile that just happened - on every single build, even when nothing
      analyzed changed. The stamp file below is what lets MSBuild skip the target entirely on a
      rebuild where @(Compile) hasn't changed, which is the common case in an edit-build loop.
    -->
    <!-- Cross-targeting builds can evaluate IntermediateOutputPath before the SDK appends the target framework.
         Keep analyzer state per framework explicitly: sharing these files lets one TFM suppress another and lets
         concurrent analyzer processes contend over the same config and stamp. -->
    <_AxialGuardrailsStampFile>$(IntermediateOutputPath)axial-guardrails.$(TargetFramework).stamp</_AxialGuardrailsStampFile>
    <_AxialGuardrailsConfigFile>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), axial-guardrails.$(TargetFramework).rules))</_AxialGuardrailsConfigFile>
    <_AxialGuardrailsGeneratedBaseline>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), axial-guardrails.$(TargetFramework).baseline))</_AxialGuardrailsGeneratedBaseline>
    <_AxialGuardrailsFingerprintFile>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), axial-guardrails.$(TargetFramework).inputs))</_AxialGuardrailsFingerprintFile>
    <_AxialGuardrailsBaselineRoot>$([System.IO.Path]::GetDirectoryName($([MSBuild]::NormalizePath($(AxialGuardrailsBaselineFile)))))</_AxialGuardrailsBaselineRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <_AxialGuardrailsPolicyInputs Include="$(MSBuildProjectFullPath);$(MSBuildAllProjects)" />
    <_AxialGuardrailsPolicyInputs Include="$(AxialGuardrailsBaselineFile)" Condition="Exists('$(AxialGuardrailsBaselineFile)')" />
    <_AxialGuardrailsPolicyInputs Include="$(ProjectAssetsFile)" Condition="Exists('$(ProjectAssetsFile)')" />
    <_AxialGuardrailsPolicyInputs Include="@(EditorConfigFiles);@(AnalyzerConfigFiles)" />
  </ItemGroup>

  <!-- Capture these after Build: generators and reference resolution can add items after project evaluation. The two
       SDK assembly-attribute files are timestamp-volatile but semantically represented by the fingerprint below. -->
  <Target Name="AxialGuardrailsWriteInputFingerprint"
          BeforeTargets="AxialGuardrailsEffectBoundaryCheck"
          Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <Error Condition="'$(_AxialGuardrailsUsesPackagedTool)' != 'true' and '@(_AxialGuardrailsConfiguredToolInput)' == ''"
           Text="An overridden _AxialGuardrailsExe requires _AxialGuardrailsConfiguredToolInput items naming its manifest and assemblies." />
    <ItemGroup>
      <_AxialGuardrailsSourceInputs Include="@(Compile)" />
      <_AxialGuardrailsSourceInputs Remove="$(GeneratedAssemblyInfoFile);$(TargetFrameworkMonikerAssemblyAttributesPath)" />
      <_AxialGuardrailsVolatileSource Include="$(GeneratedAssemblyInfoFile);$(TargetFrameworkMonikerAssemblyAttributesPath)" Condition="Exists('%(Identity)')" />
      <!-- Match CoreCompile's inputs: project references use stable reference assemblies when available. -->
      <_AxialGuardrailsReferenceInputs Include="@(ReferencePathWithRefAssemblies)" />
    </ItemGroup>
    <GetFileHash Files="@(_AxialGuardrailsVolatileSource)" Algorithm="SHA256" Condition="'@(_AxialGuardrailsVolatileSource)' != ''">
      <Output TaskParameter="Items" ItemName="_AxialGuardrailsVolatileSourceHash" />
    </GetFileHash>
    <!-- Reference outputs may be rewritten with a fresh timestamp by an otherwise no-op project-reference build.
         Hash their deterministic contents so that such rewrites do not invalidate the analysis result. -->
    <GetFileHash Files="@(_AxialGuardrailsReferenceInputs)" Algorithm="SHA256" Condition="'@(_AxialGuardrailsReferenceInputs)' != ''">
      <Output TaskParameter="Items" ItemName="_AxialGuardrailsReferenceHash" />
    </GetFileHash>
    <ItemGroup>
      <_AxialGuardrailsFingerprintLine Include="TargetFramework=$(TargetFramework)" />
      <_AxialGuardrailsFingerprintLine Include="DefineConstants=$(DefineConstants)" />
      <_AxialGuardrailsFingerprintLine Include="LangVersion=$(LangVersion)" />
      <_AxialGuardrailsFingerprintLine Include="TreatWarningsAsErrors=$(TreatWarningsAsErrors)" />
      <_AxialGuardrailsFingerprintLine Include="WarningsAsErrors=$(WarningsAsErrors)" />
      <_AxialGuardrailsFingerprintLine Include="WarningsNotAsErrors=$(WarningsNotAsErrors)" />
      <_AxialGuardrailsFingerprintLine Include="NoWarn=$(NoWarn)" />
      <_AxialGuardrailsFingerprintLine Include="@(_AxialGuardrailsSourceInputs->'source=%(FullPath)')" />
      <_AxialGuardrailsFingerprintLine Include="@(_AxialGuardrailsReferenceHash->'reference=%(FullPath)|%(FileHash)')" />
      <_AxialGuardrailsFingerprintLine Include="@(EditorConfigFiles->'analyzerConfig=%(FullPath)')" />
      <_AxialGuardrailsFingerprintLine Include="@(AnalyzerConfigFiles->'analyzerConfig=%(FullPath)')" />
      <_AxialGuardrailsFingerprintLine Include="@(_AxialGuardrailsVolatileSourceHash->'volatileSource=%(FullPath)|%(FileHash)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_AxialGuardrailsFingerprintFile)" Lines="@(_AxialGuardrailsFingerprintLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="AxialGuardrailsRejectCiBypass" BeforeTargets="Build" Condition="'$(CI)' == 'true'">
    <Error Condition="'$(AxialGuardrailsEnabled)' != 'true'"
           Text="Axial.Guardrails must be enabled when CI=true. Use a checked-in baseline for existing findings." />
    <Error Condition="'$(AxialGuardrailsGenerateBaseline)' == 'true'"
           Text="Axial.Guardrails baseline generation is a local review command and cannot run when CI=true." />
    <Error Condition="'$(_AxialGuardrailsEnabledEnvironment)' != '' or '$(_AxialGuardrailsEnabledEnvironmentUpper)' != '' or '$(_AxialGuardrailsSeverityEnvironment)' != '' or '$(_AxialGuardrailsSeverityEnvironmentUpper)' != ''"
           Text="Axial.Guardrails cannot be disabled or downgraded through environment variables when CI=true. Use a checked-in baseline for existing findings." />
  </Target>

  <!--
    Self-heals the case the Exists() guard below exists for: a repo (like this one) pointing
    _AxialGuardrailsAnalyzersPath at its own live build output, hit before that project has ever
    been built. Builds it once, directly - no ProjectReference, so no per-project graph-evaluation
    cost on every subsequent build (see Directory.Build.targets for why that matters). A real
    package consumer never sets _AxialGuardrailsBootstrapProject, so this never runs for them: the
    analyzer always arrives pre-built inside the restored nupkg.

    If several projects build in parallel before the folder exists, more than one of these can fire
    at once; harmless (dotnet build is idempotent), just briefly redundant.
  -->
  <Target Name="AxialGuardrailsEnsureBuilt"
          BeforeTargets="AxialGuardrailsEffectBoundaryCheck"
          Condition="'$(AxialGuardrailsEnabled)' == 'true' and '$(_AxialGuardrailsBootstrapProject)' != '' and !Exists('$(_AxialGuardrailsAnalyzersPath)\Axial.Guardrails.Analyzers.dll')">
    <Exec Command="dotnet build &quot;$(_AxialGuardrailsBootstrapProject)&quot; --nologo -v quiet" />
  </Target>

  <!--
    Runs after every build of a project that references Axial.Guardrails, but only when @(Compile)
    is newer than the stamp file from the last successful run (see Inputs/Outputs above). Deliberately
    does not use FSharp.Analyzers.Build's own AfterBuild target: that target ignores the
    exit code without failing the build. Capture the CLI exit code instead: findings return -2
    (254 on Unix), while other non-zero codes indicate a tool failure.

    If the analyzer path is still missing after AxialGuardrailsEnsureBuilt, the check fails with a package/path
    repair instruction instead of silently skipping analysis.
  -->
  <!--
    Resolves @(AxialGuardrail) and @(AxialGuardrailRule) into the rules file the analyzers read (see
    GuardrailConfig.fs for the format). WriteOnlyWhenDifferent keeps its timestamp stable, so the check below reruns
    only when the configuration or the sources change. Metadata must not contain semicolons; escape them as %3B.
  -->
  <Target Name="AxialGuardrailsValidateBoundaries"
          BeforeTargets="AxialGuardrailsWriteConfig"
          Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <ItemGroup>
      <_AxialGuardrailsInvalidBoundary Include="@(AxialGuardrailsBoundary)"
          Condition="'%(AxialGuardrailsBoundary.RecursiveDir)' != '' or $([System.String]::Copy('%(AxialGuardrailsBoundary.OriginalItemSpec)').Contains('*')) or $([System.String]::Copy('%(AxialGuardrailsBoundary.OriginalItemSpec)').Contains('?'))" />
    </ItemGroup>
    <Error Condition="'@(_AxialGuardrailsInvalidBoundary)' != ''"
           Text="AxialGuardrailsBoundary requires explicit files; recursive, wildcard, and directory-wide declarations are not allowed: @(_AxialGuardrailsInvalidBoundary, ', ')" />
    <Error Condition="@(AxialGuardrailsBoundary->Count()) &gt; $(AxialGuardrailsBoundaryLimit)"
           Text="AxialGuardrailsBoundary contains @(AxialGuardrailsBoundary->Count()) files, exceeding AxialGuardrailsBoundaryLimit=$(AxialGuardrailsBoundaryLimit). Review and narrow the boundary list." />
  </Target>

  <Target Name="AxialGuardrailsWriteConfig"
          BeforeTargets="AxialGuardrailsEffectBoundaryCheck"
          Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <ReadLinesFromFile File="$(AxialGuardrailsBaselineFile)" Condition="Exists('$(AxialGuardrailsBaselineFile)')">
      <Output TaskParameter="Lines" ItemName="_AxialGuardrailsBaselineEntry" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_AxialGuardrailsConfigLine Include="@(AxialGuardrail->'guardrail&#9;%(Identity)')" />
      <_AxialGuardrailsConfigLine Include="@(AxialGuardrailsBoundary->'boundary&#9;%(FullPath)')" />
      <_AxialGuardrailsConfigLine Include="@(_AxialGuardrailsBaselineEntry->'baseline&#9;%(Identity)')" />
      <_AxialGuardrailsConfigLine Include="setting&#9;baselineRoot&#9;$(_AxialGuardrailsBaselineRoot)" />
      <_AxialGuardrailsConfigLine Include="setting&#9;baselineOutput&#9;$(_AxialGuardrailsGeneratedBaseline)" Condition="'$(AxialGuardrailsGenerateBaseline)' == 'true'" />
      <_AxialGuardrailsConfigLine Include="setting&#9;nativeAot&#9;true" Condition="'$(IsAotCompatible)' == 'true' or '$(PublishAot)' == 'true'" />
      <_AxialGuardrailsConfigLine Include="setting&#9;nativeAot&#9;false" Condition="'$(IsAotCompatible)' != 'true' and '$(PublishAot)' != 'true'" />
      <_AxialGuardrailsConfigLine Include="@(AxialGuardrailRule->'rule&#9;%(Identity)&#9;%(Guardrail)&#9;%(Category)&#9;%(Match)&#9;%(Scope)&#9;%(Message)&#9;%(Replacement)')" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <WriteLinesToFile File="$(_AxialGuardrailsConfigFile)" Lines="@(_AxialGuardrailsConfigLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Analyzer and the exact CLI installation are inputs: changing either must invalidate a successful result. An
       overridden command cannot be inferred safely, so its importer must identify the manifest/assemblies it uses. -->
  <ItemGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <_AxialGuardrailsToolInputs Include="$(_AxialGuardrailsAnalyzersPath)\*.dll" />
    <_AxialGuardrailsToolInputs Include="$(_AxialGuardrailsToolPath)*.dll" Condition="'$(_AxialGuardrailsUsesPackagedTool)' == 'true'" />
    <_AxialGuardrailsToolInputs Include="@(_AxialGuardrailsConfiguredToolInput)" />
  </ItemGroup>

  <Target Name="AxialGuardrailsEffectBoundaryCheck"
          AfterTargets="Build"
          Condition="'$(AxialGuardrailsEnabled)' == 'true' and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' != '')"
          Inputs="@(_AxialGuardrailsSourceInputs);@(_AxialGuardrailsPolicyInputs);$(_AxialGuardrailsConfigFile);$(_AxialGuardrailsFingerprintFile);@(_AxialGuardrailsToolInputs)"
          Outputs="$(_AxialGuardrailsStampFile)">
    <Error Condition="!Exists('$(_AxialGuardrailsAnalyzersPath)\Axial.Guardrails.Analyzers.dll')"
           Text="Axial.Guardrails analyzer folder is missing or incomplete: $(_AxialGuardrailsAnalyzersPath). Restore/reinstall the package or fix the configured analyzer path." />
    <Message Importance="high" Text="Running Axial.Guardrails analysis for $(MSBuildProjectName) ($(TargetFramework))." />
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <Delete Files="$(_AxialGuardrailsGeneratedBaseline)" Condition="'$(AxialGuardrailsGenerateBaseline)' == 'true'" />
    <Message Importance="high" Condition="'$(AxialGuardrailsGenerateBaseline)' == 'true'"
             Text="Axial.Guardrails is generating a candidate baseline. Diagnostics remain errors; review the candidate, and do not enable generation in normal builds." />
    <Exec Command="$(_AxialGuardrailsExe) --project &quot;$(MSBuildProjectFullPath)&quot; --property TargetFramework=$(TargetFramework) --configuration $(Configuration) --analyzers-path &quot;$(_AxialGuardrailsAnalyzersPath)&quot; $(_AxialGuardrailsIncludeAnalyzersFlag) --code-root &quot;$(MSBuildProjectDirectory)&quot;"
          EnvironmentVariables="AXIAL_GUARDRAILS_CONFIG=$(_AxialGuardrailsConfigFile)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_AxialGuardrailsExit" />
    </Exec>
    <!-- CLI help does not document exit codes; 254 may also indicate a tool failure. -->
    <Error Condition="'$(_AxialGuardrailsExit)' == '-2' or '$(_AxialGuardrailsExit)' == '254'"
           Text="Axial.Guardrails reported findings or failed; see the output above (AXG codes or tool errors)." />
    <Error Condition="'$(_AxialGuardrailsExit)' != '0' and '$(_AxialGuardrailsExit)' != '-2' and '$(_AxialGuardrailsExit)' != '254'"
           Text="Axial.Guardrails analyzer tool failed (exit code $(_AxialGuardrailsExit)); inspect the output above." />
    <Warning Code="AXGGEN" Condition="'$(AxialGuardrailsGenerateBaseline)' == 'true'"
             Text="Axial.Guardrails baseline candidate: $(_AxialGuardrailsGeneratedBaseline). This is a generation run, not normal verification." />
    <Touch Files="$(_AxialGuardrailsStampFile)" AlwaysCreate="true" />
  </Target>

</Project>
