<Project>

  <PropertyGroup Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <!--
      A caller that imports this file directly (rather than getting it via PackageReference) can
      set _AxialGuardrailsAnalyzersPath and _AxialGuardrailsExe before importing, to point at a
      locally built analyzer and locally installed CLI instead of the packaged analyzers/ and
      cli/ folders. Axial's own repo does exactly this in Directory.Build.targets, so its own
      build runs the identical check a package consumer gets, with no separate script.
    -->
    <_AxialGuardrailsAnalyzersPath Condition="'$(_AxialGuardrailsAnalyzersPath)' == ''">$(MSBuildThisFileDirectory)..\analyzers</_AxialGuardrailsAnalyzersPath>
    <_AxialGuardrailsExe Condition="'$(_AxialGuardrailsExe)' == ''">dotnet &quot;$(MSBuildThisFileDirectory)..\cli\FSharp.Analyzers.Cli.dll&quot;</_AxialGuardrailsExe>
    <_AxialGuardrailsSeverityFlag Condition="'$(AxialGuardrailsSeverity)' == 'error'">--treat-as-error</_AxialGuardrailsSeverityFlag>
    <_AxialGuardrailsSeverityFlag Condition="'$(AxialGuardrailsSeverity)' != 'error'">--treat-as-warning</_AxialGuardrailsSeverityFlag>
    <!--
      AXG001-003 are about ambient effects and raw exceptions bypassing Axial's own explicit
      service boundaries - real signal in application/library code, but noise in a test project,
      which legitimately touches Thread.Sleep/File/DateTimeOffset/raw exceptions for setup and
      assertions. $(IsTestProject) is set by the test SDK (Microsoft.NET.Test.Sdk), so a project
      built with `dotnet test` gets only AXG004 (shared xUnit fixtures) by default.
    -->
    <_AxialGuardrailsCodes Condition="'$(IsTestProject)' == 'true'">AXG004</_AxialGuardrailsCodes>
    <_AxialGuardrailsCodes Condition="'$(IsTestProject)' != 'true'">AXG001 AXG002 AXG003 AXG004 AXG005</_AxialGuardrailsCodes>
    <!--
      The severity flag only overrides the severity of the named codes; it does not restrict which
      analyzers run. The analyzers filter (below, by analyzer name) is what actually keeps
      AXG001-003 from running - and therefore from being reported at their default Warning
      severity - against a test project at all.
    -->
    <_AxialGuardrailsIncludeAnalyzersFlag Condition="'$(IsTestProject)' == 'true'">--include-analyzers Fixture</_AxialGuardrailsIncludeAnalyzersFlag>
  </PropertyGroup>

  <!--
    Runs after every build of a project that references Axial.Guardrails. Deliberately does not use
    FSharp.Analyzers.Build's own AfterBuild target: that target hardcodes IgnoreExitCode="true", so it
    can never fail a build regardless of severity. This target instead lets Exec's normal exit-code
    handling do the work: the CLI itself exits non-zero only when a finding is treated as an error, so
    AxialGuardrailsSeverity=warning (the default) can never fail the build, and =error always does.
  -->
  <Target Name="AxialGuardrailsEffectBoundaryCheck"
          AfterTargets="Build"
          Condition="'$(AxialGuardrailsEnabled)' == 'true'">
    <Exec Command="$(_AxialGuardrailsExe) --project &quot;$(MSBuildProjectFullPath)&quot; --analyzers-path &quot;$(_AxialGuardrailsAnalyzersPath)&quot; $(_AxialGuardrailsIncludeAnalyzersFlag) $(_AxialGuardrailsSeverityFlag) $(_AxialGuardrailsCodes) --code-root &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

</Project>
