<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
    <AssemblyName>Axial.Process</AssemblyName>
    <RootNamespace>Axial.Process</RootNamespace>
    <PackageId>Axial.Process</PackageId>
    <Authors>Adam Davies</Authors>
    <PackageMaturity>Incubating</PackageMaturity>
    <Description>Composable external processes for F# workflows, with pipelines, streaming, typed failures, cancellation and safe cleanup.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Axial</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fsharp;axial;flow;process;shell;pipeline</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axial\Axial.fsproj" />
    <ProjectReference Include="..\Axial.PlatformService\Axial.PlatformService.fsproj" />
    <ProjectReference Include="..\Axial.Console\Axial.Console.fsproj" />
    <ProjectReference Include="..\Axial.FileSystem\Axial.FileSystem.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="ProcessTypes.fs" />
    <Compile Include="ProcessInfrastructure.fs" />
    <Compile Include="ProcessLive.fs" />
    <Compile Include="ProcessRun.fs" />
    <Compile Include="Process.fs" />
    <Compile Include="ProcessStream.fs" />
    <Compile Include="ProcessDsl.fs" />
  </ItemGroup>

</Project>
