<Project>
  <!-- Referencing Axial.Console turns on its Axial.Guardrails guardrail; its rules ship in Axial.Guardrails.
       Remove it with <AxialGuardrail Remove="Axial.Console" />, or set its severity with
       <AxialGuardrail Update="Axial.Console" Severity="warning" />. -->
  <ItemGroup>
    <AxialGuardrail Include="Axial.Console" />
  </ItemGroup>
</Project>
