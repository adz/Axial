<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
    <AssemblyName>Axial.FileSystem</AssemblyName>
    <RootNamespace>Axial.FileSystem</RootNamespace>
    <PackageId>Axial.FileSystem</PackageId>
    <Authors>Adam Davies</Authors>
    <PackageMaturity>Incubating</PackageMaturity>
    <Description>Standard file-system service for Axial workflows.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Axial</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fsharp;axial;flow;filesystem;io;platform;fable-javascript</PackageTags>
    <FablePackageType>library</FablePackageType>
    <!-- Fable.Package.SDK defaults to embedded PDBs, which would leave the snupkg empty. -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Fable.Package.SDK" Version="$(FablePackageSdkVersion)" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axial\Axial.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FileSystem.fs" AxialCapability="filesystem" />
    <Compile Include="FileLog.fs" />
  </ItemGroup>

</Project>
