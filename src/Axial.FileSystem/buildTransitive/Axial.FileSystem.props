<Project>
  <!-- Referencing Axial.FileSystem turns on its Axial.Guardrails guardrail; its rules ship in Axial.Guardrails.
       Remove it with <AxialGuardrail Remove="Axial.FileSystem" />, or set its severity with
       <AxialGuardrail Update="Axial.FileSystem" Severity="warning" />. -->
  <ItemGroup>
    <AxialGuardrail Include="Axial.FileSystem" />
  </ItemGroup>
</Project>
