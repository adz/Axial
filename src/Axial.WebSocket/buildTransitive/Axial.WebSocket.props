<Project>
  <!-- Referencing Axial.WebSocket turns on its Axial.Guardrails guardrail; its rules ship in Axial.Guardrails.
       Remove it with <AxialGuardrail Remove="Axial.WebSocket" /> to opt out of that package-specific rule set. -->
  <ItemGroup>
    <AxialGuardrail Include="Axial.WebSocket" />
  </ItemGroup>
</Project>
