<Project>
  <!-- Referencing Axial.WebSocket turns on its Axial.Guardrails guardrail; its rules ship in Axial.Guardrails.
       Remove it with <AxialGuardrail Remove="Axial.WebSocket" />, or set its severity with
       <AxialGuardrail Update="Axial.WebSocket" Severity="warning" />. -->
  <ItemGroup>
    <AxialGuardrail Include="Axial.WebSocket" />
  </ItemGroup>
</Project>
