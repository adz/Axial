<Project>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>

    <!-- Local/dev default only; the release workflow stamps the real version via -p:Version from the release tag. -->
    <VersionPrefix>0.7.1</VersionPrefix>
    <ReifiedVersion Condition="'$(ReifiedVersion)' == ''">0.11.0</ReifiedVersion>
    <NuGetAudit>false</NuGetAudit>
    <RepositoryUrl>https://github.com/adz/Axial</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageProjectUrl>https://github.com/adz/Axial</PackageProjectUrl>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>

    <!-- Build distributable F# libraries without generated reflection-based structural formatting. -->
    <OtherFlags Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src')) and '$(MSBuildProjectName)' != 'Axial.Guardrails'">$(OtherFlags) --reflectionfree</OtherFlags>

    <!--
      Every project in Axial.slnx treats compiler and Guardrails warnings as errors. This keeps
      examples and benchmarks subject to the same clean-build contract as libraries and tests.
      AXIAL_GUARDRAILS_SEVERITY, if set in the environment, overrides the repository default; an
      individual project can still override AxialGuardrailsEnabled/AxialGuardrailsSeverity itself,
      the same way an external consumer would.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AxialGuardrailsEnabled Condition="'$(AxialGuardrailsEnabled)' == ''">true</AxialGuardrailsEnabled>
    <AxialGuardrailsSeverity Condition="'$(AxialGuardrailsSeverity)' == '' and '$(AXIAL_GUARDRAILS_SEVERITY)' != ''">$(AXIAL_GUARDRAILS_SEVERITY)</AxialGuardrailsSeverity>
    <AxialGuardrailsSeverity Condition="'$(AxialGuardrailsSeverity)' == ''">error</AxialGuardrailsSeverity>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- A package that owns an Axial.Guardrails guardrail ships a buildTransitive props file that turns it on. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/buildTransitive/$(MSBuildProjectName).props')">
    <None Include="$(MSBuildProjectDirectory)/buildTransitive/$(MSBuildProjectName).props" Pack="true" PackagePath="buildTransitive/" Visible="false" />
  </ItemGroup>

  <!--
    This repository references its packages as projects, so their buildTransitive props never import here. Every
    project gets every guardrail, as a consumer referencing all the packages would.
  -->
  <ItemGroup>
    <AxialGuardrail Include="Axial" />
    <AxialGuardrail Include="Axial.PlatformService" />
    <AxialGuardrail Include="Axial.Console" />
    <AxialGuardrail Include="Axial.FileSystem" />
    <AxialGuardrail Include="Axial.Process" />
    <AxialGuardrail Include="Axial.HttpClient" />
    <AxialGuardrail Include="Axial.WebSocket" />
  </ItemGroup>
</Project>
