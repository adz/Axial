<Project>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>

    <!-- The SDK enables F# reference assemblies for net7.0+, but not netstandard. Axial multi-targets both;
         enabling them consistently keeps body-only changes from invalidating downstream project references. -->
    <ProduceReferenceAssembly Condition="'$(MSBuildProjectExtension)' == '.fsproj'">true</ProduceReferenceAssembly>

    <!-- Local/dev default only; the release workflow stamps the real version via -p:Version from the release tag. -->
    <VersionPrefix>0.7.1</VersionPrefix>
    <ReifiedVersion Condition="'$(ReifiedVersion)' == ''">0.11.0</ReifiedVersion>
    <NuGetAudit>false</NuGetAudit>
    <RepositoryUrl>https://github.com/adz/Axial</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageProjectUrl>https://github.com/adz/Axial</PackageProjectUrl>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>

    <!-- Build distributable F# libraries without generated reflection-based structural formatting. -->
    <OtherFlags Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src')) and '$(MSBuildProjectName)' != 'Axial.Guardrails'">$(OtherFlags) --reflectionfree</OtherFlags>

    <!-- Every new Guardrails finding is an error. Existing violations can be retained only in the baseline. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AxialGuardrailsEnabled Condition="'$(AxialGuardrailsEnabled)' == ''">true</AxialGuardrailsEnabled>
    <AxialGuardrailsBaselineFile>$(MSBuildThisFileDirectory)Axial.Guardrails.baseline</AxialGuardrailsBaselineFile>
    <!-- Temporary through Guardrails v2 slice 1d: this repository still uses its v1 MSBuild policy. -->
    <AxialGuardrailsUseLegacyPolicy>true</AxialGuardrailsUseLegacyPolicy>

    <!-- Repo-internal projects that must not import Guardrails: the analyzer's own tests and fixture, and the
         comparative benchmarks, whose plain-.NET implementations use ambient effects on purpose. -->
    <_AxialRepoSkipGuardrails Condition="'$(MSBuildProjectFullPath)' == '$(MSBuildThisFileDirectory)tests/Axial.Guardrails.Tests/Axial.Guardrails.Tests.fsproj' or '$(MSBuildProjectFullPath)' == '$(MSBuildThisFileDirectory)tests/Axial.PrintfFixture/Axial.PrintfFixture.fsproj' or '$(MSBuildProjectFullPath)' == '$(MSBuildThisFileDirectory)benchmarks/Axial.Comparative/Axial.Comparative.fsproj'">true</_AxialRepoSkipGuardrails>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- A package that owns an Axial.Guardrails guardrail ships a buildTransitive props file that turns it on. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/buildTransitive/$(MSBuildProjectName).props')">
    <None Include="$(MSBuildProjectDirectory)/buildTransitive/$(MSBuildProjectName).props" Pack="true" PackagePath="buildTransitive/" Visible="false" />
  </ItemGroup>

  <!--
    This repository references its packages as projects, so their buildTransitive props never import here. Every
    project gets every guardrail, as a consumer referencing all the packages would.
  -->
  <ItemGroup>
    <AxialGuardrailsBoundary Include="$(MSBuildThisFileDirectory)benchmarks/Axial.Benchmarks/Common.fs;$(MSBuildThisFileDirectory)benchmarks/Axial.Benchmarks/FiberCostBenchmarks.fs;$(MSBuildThisFileDirectory)benchmarks/Axial.Benchmarks/Suites.fs" />
    <AxialGuardrailsBoundary Include="$(MSBuildThisFileDirectory)examples/Axial.AotProbe/Program.fs;$(MSBuildThisFileDirectory)examples/Axial.App.Example/Program.fs;$(MSBuildThisFileDirectory)examples/Axial.Comparisons/CheckoutCompensation.fs;$(MSBuildThisFileDirectory)examples/Axial.Comparisons/RetryBudget.fs;$(MSBuildThisFileDirectory)examples/Axial.Comparisons/ScopedWorkspace.fs;$(MSBuildThisFileDirectory)examples/Axial.Examples/Program.fs;$(MSBuildThisFileDirectory)examples/Axial.Hosting.Desktop.Example/Program.fs;$(MSBuildThisFileDirectory)examples/Axial.Hosting.DotNet.Example/Program.fs;$(MSBuildThisFileDirectory)examples/Axial.MaintenanceExamples/Program.fs;$(MSBuildThisFileDirectory)examples/Axial.TortureTest/Interop.fs;$(MSBuildThisFileDirectory)examples/Axial.TortureTest/Scenario.fs" />
    <AxialGuardrailsBoundary Include="$(MSBuildThisFileDirectory)src/Axial/App.fs;$(MSBuildThisFileDirectory)src/Axial.Console/Console.fs;$(MSBuildThisFileDirectory)src/Axial/Core.fs;$(MSBuildThisFileDirectory)src/Axial.ElmishFlows/Sub.fs;$(MSBuildThisFileDirectory)src/Axial.ElmishFlows/TestRuntime.fs;$(MSBuildThisFileDirectory)src/Axial.FileSystem/FileSystem.fs;$(MSBuildThisFileDirectory)src/Axial/Flow.fs;$(MSBuildThisFileDirectory)src/Axial.Hosting/Hosting.fs;$(MSBuildThisFileDirectory)src/Axial/Parallelism.fs;$(MSBuildThisFileDirectory)src/Axial/Platform.fs;$(MSBuildThisFileDirectory)src/Axial.PlatformService/Operations.fs;$(MSBuildThisFileDirectory)src/Axial.PlatformService/Platform.fs;$(MSBuildThisFileDirectory)src/Axial.Process/Process.fs;$(MSBuildThisFileDirectory)src/Axial.Process/ProcessLive.fs;$(MSBuildThisFileDirectory)src/Axial.Process/ProcessRun.fs;$(MSBuildThisFileDirectory)src/Axial/Stream.fs;$(MSBuildThisFileDirectory)src/Axial.WebSocket/WebSocket.fs" />
    <AxialGuardrailsBoundary Include="$(MSBuildThisFileDirectory)tests/Axial.ElmishFlows.Tests/SubscriptionTests.fs;$(MSBuildThisFileDirectory)tests/Axial.Fable.Tests/Harness.fs;$(MSBuildThisFileDirectory)tests/Axial.HttpClient.Tests/HttpServiceTests.fs;$(MSBuildThisFileDirectory)tests/Axial.Tests/ScopedResourceOwnershipTests.fs" />

    <AxialGuardrail Include="Axial" />
    <AxialGuardrail Include="Axial.PlatformService" />
    <AxialGuardrail Include="Axial.Console" />
    <AxialGuardrail Include="Axial.FileSystem" />
    <AxialGuardrail Include="Axial.Process" />
    <AxialGuardrail Include="Axial.HttpClient" />
    <AxialGuardrail Include="Axial.WebSocket" />
  </ItemGroup>
</Project>
